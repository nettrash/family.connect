<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- REST + WebSocket to the family's self-hosted server. -->
    <!--
         Recording a voice note. Unlike CAMERA — which must NOT be declared,
         because MediaStore's capture intents throw when an app declares it
         without holding it — this one is genuinely required: the app opens
         the microphone itself rather than handing off to another app.
    -->
    <!-- Sharing a location. Both, because either is enough: COARSE alone
         names a street, which is what "where are you?" asks, so a member
         who grants only the approximate permission still gets the feature.
         Asked at the moment of use, never held in the background, and the
         app has no background location permission at all. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ConnectivityObserver — short-circuits the reconnect backoff the
         moment a network comes back instead of waiting out the delay. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Push notifications (runtime permission on Android 13+; requested
         the first time the chat list is shown — see ChatListScreen). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Voice calls (docs/protocol.md, "Voice calls"). A call runs behind a
         foreground service of the phoneCall type — which 14+ ties to
         MANAGE_OWN_CALLS — plus the microphone type once the runtime
         permission is held; the ringing notification's full-screen intent is
         what lights up a locked phone; MODIFY_AUDIO_SETTINGS is the
         communication audio mode and the speaker route; WAKE_LOCK is
         libwebrtc's, for the audio threads while the screen is off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Saving a photo or video to the gallery. API 29+ writes through
         MediaStore with no permission at all; only 26–28 need this, hence
         the cap — it must never be requested on a modern device. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Package visibility (Android 11+): without this, resolving "who can
         open a PDF" returns nothing and every downloaded file looks
         unopenable. Scoped to VIEW intents, not a blanket QUERY_ALL. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".FamilyConnectApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FamilyConnect">

        <!-- singleTop: a notification tap while the app is already open
             lands in onNewIntent instead of stacking a second copy. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The OS share target (docs/protocol.md, "Photos, videos,
                 audio, files and locations"): share files, images, videos,
                 audio or text from any app; a chat picker follows and the
                 items land STAGED in that chat's composer — nothing
                 auto-sends. Shared text/plain becomes composer TEXT, not
                 an attachment. launchMode stays singleTop, so a share
                 while the app is open arrives via onNewIntent. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>

        <!-- Hands a downloaded attachment to whatever app can open it.
             A content:// Uri with a one-shot read grant is the only way
             to share a file since Android 7 — a file:// Uri throws
             FileUriExposedException — and `grantUriPermissions` keeps the
             grant scoped to the single Intent rather than the directory. -->
        <!-- The map on a shared location. The key comes from a gitignored
             local.properties (or a CI env var) via manifestPlaceholders —
             it is never in the repo. Empty is a supported state: the UI
             branches on BuildConfig.HAS_MAPS_KEY and simply draws the pin
             card instead of Google's grey "authorization failure" tile. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- FCM entry point: token rotation (onNewToken) and foreground
             message delivery (onMessageReceived). Inert when the build has
             no google-services.json — FirebaseApp never initializes, so
             FCM never binds this service. -->
        <service
            android:name=".data.push.FcPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- The foreground service a voice call lives behind: ringing
             (started from the call push, while the phone still may) and
             then the call itself. Both types are declared; the microphone
             one is only ever REQUESTED once RECORD_AUDIO is held — see
             CallService.foregroundType. -->
        <service
            android:name=".calls.CallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone" />

    </application>

</manifest>
