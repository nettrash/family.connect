<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- REST + WebSocket to the family's self-hosted server. -->
    <!--
         Recording a voice note. Unlike CAMERA — which must NOT be declared,
         because MediaStore's capture intents throw when an app declares it
         without holding it — this one is genuinely required: the app opens
         the microphone itself rather than handing off to another app.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ConnectivityObserver — short-circuits the reconnect backoff the
         moment a network comes back instead of waiting out the delay. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Push notifications (runtime permission on Android 13+; requested
         the first time the chat list is shown — see ChatListScreen). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Saving a photo or video to the gallery. API 29+ writes through
         MediaStore with no permission at all; only 26–28 need this, hence
         the cap — it must never be requested on a modern device. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Package visibility (Android 11+): without this, resolving "who can
         open a PDF" returns nothing and every downloaded file looks
         unopenable. Scoped to VIEW intents, not a blanket QUERY_ALL. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".FamilyConnectApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FamilyConnect">

        <!-- singleTop: a notification tap while the app is already open
             lands in onNewIntent instead of stacking a second copy. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands a downloaded attachment to whatever app can open it.
             A content:// Uri with a one-shot read grant is the only way
             to share a file since Android 7 — a file:// Uri throws
             FileUriExposedException — and `grantUriPermissions` keeps the
             grant scoped to the single Intent rather than the directory. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- FCM entry point: token rotation (onNewToken) and foreground
             message delivery (onMessageReceived). Inert when the build has
             no google-services.json — FirebaseApp never initializes, so
             FCM never binds this service. -->
        <service
            android:name=".data.push.FcPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
