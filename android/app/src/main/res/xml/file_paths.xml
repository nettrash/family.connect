<?xml version="1.0" encoding="utf-8"?>
<!--
  What FileProvider may hand out.

  Only purpose-built directories, never the whole cache or the raw
  attachment cache that sits next to them.
-->
<paths>
    <cache-path
        name="attachment_files"
        path="attachments/files/" />
    <cache-path
        name="photo_transfers"
        path="attachments/photo-transfers/" />
    <!--
      Where the camera writes. Its own directory, not shared with the one
      above: the capture intent needs WRITE access to the Uri it is handed,
      and downloaded attachments must stay read-only to other apps.
    -->
    <cache-path
        name="captures"
        path="captures/" />
</paths>
