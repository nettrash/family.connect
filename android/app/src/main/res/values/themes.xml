<resources>
    <!-- Platform theme only bridges the gap until Compose takes over;
         all real theming lives in ui/theme/Theme.kt. The window
         background is per-mode (values-night/colors.xml) — it is what
         shows through between screens during a nav transition. -->
    <style name="Theme.FamilyConnect" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
