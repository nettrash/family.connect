<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher foreground — a house with a heart inside, hand-authored so the
    icon carries no asset-pipeline dependency. The 108dp adaptive canvas
    keeps all strokes inside the 66dp safe zone; the heart is drawn in the
    background green so it reads as a cutout.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- House body + roof, one filled silhouette. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,30 L82,53 L76,53 L76,78 L32,78 L32,53 L26,53 Z" />
    <!-- Chimney. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M68,33 h6 v9 l-6,-5 Z" />
    <!-- Heart cutout, background-colored so it punches through the house. -->
    <path
        android:fillColor="#FF2E7D6B"
        android:pathData="M54,70 C54,70 43.5,62.6 43.5,56.2 C43.5,52.4 46.4,49.8 49.7,49.8 C51.5,49.8 53.2,50.8 54,52.3 C54.8,50.8 56.5,49.8 58.3,49.8 C61.6,49.8 64.5,52.4 64.5,56.2 C64.5,62.6 54,70 54,70 Z" />
</vector>
