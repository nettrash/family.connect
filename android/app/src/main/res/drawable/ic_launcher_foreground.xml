<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher foreground — a speech bubble holding a family: two adult
    silhouettes with a child in front, hand-authored so the icon carries no
    asset-pipeline dependency. The bubble spans ~50dp of the 108dp adaptive
    canvas, inside the 66dp safe zone every mask shape preserves. The
    figures are drawn in the launcher background blue so they read as
    cutouts; the child is separated from the adults by a white gap stroke,
    matching the iOS 1024px icon (same geometry, scaled by 0.0622).
    iOS counterpart: ios/FamilyConnect/Assets.xcassets/AppIcon.appiconset
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Bubble body. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 39.7 29.0 H 68.3 A 10.6 10.6 0 0 1 78.9 39.6 V 58.7 A 10.6 10.6 0 0 1 68.3 69.3 H 39.7 A 10.6 10.6 0 0 1 29.1 58.7 V 39.6 A 10.6 10.6 0 0 1 39.7 29.0 Z" />
    <!-- Bubble tail, filled separately so path winding can never cancel. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 37.5 59.6 Q 37.9 72.0 35.3 78.4 Q 42.0 76.2 49.5 68.3 Z" />
    <!-- Figures, clipped to the bubble so flat body bottoms end on white. -->
    <group>
        <clip-path
            android:pathData="M 39.7 29.0 H 68.3 A 10.6 10.6 0 0 1 78.9 39.6 V 58.7 A 10.6 10.6 0 0 1 68.3 69.3 H 39.7 A 10.6 10.6 0 0 1 29.1 58.7 V 39.6 A 10.6 10.6 0 0 1 39.7 29.0 Z" />
        <!-- Adult left: head circle + capsule-top body. -->
        <path
            android:fillColor="#FF0D47A1"
            android:pathData="M 42.3 41.9 A 3.86 3.86 0 1 0 50.1 41.9 A 3.86 3.86 0 1 0 42.3 41.9 Z M 39.9 63.3 L 39.9 53.8 A 6.35 6.35 0 0 1 52.6 53.8 L 52.6 63.3 Z" />
        <!-- Adult right. -->
        <path
            android:fillColor="#FF0D47A1"
            android:pathData="M 57.8 41.9 A 3.86 3.86 0 1 0 65.6 41.9 A 3.86 3.86 0 1 0 57.8 41.9 Z M 55.4 63.3 L 55.4 53.8 A 6.35 6.35 0 0 1 68.1 53.8 L 68.1 63.3 Z" />
        <!-- Child, in front: white gap stroke first, then the brand-blue fill. -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.74"
            android:pathData="M 51.0 49.0 A 2.99 2.99 0 1 0 57.0 49.0 A 2.99 2.99 0 1 0 51.0 49.0 Z M 49.3 63.3 L 49.3 58.0 A 4.73 4.73 0 0 1 58.8 58.0 L 58.8 63.3 Z" />
        <path
            android:fillColor="#FF0D47A1"
            android:pathData="M 51.0 49.0 A 2.99 2.99 0 1 0 57.0 49.0 A 2.99 2.99 0 1 0 51.0 49.0 Z M 49.3 63.3 L 49.3 58.0 A 4.73 4.73 0 0 1 58.8 58.0 L 58.8 63.3 Z" />
    </group>
</vector>
