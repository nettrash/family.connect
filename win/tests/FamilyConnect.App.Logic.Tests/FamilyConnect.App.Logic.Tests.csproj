<Project Sdk="Microsoft.NET.Sdk">
  <!--
    FamilyConnect.App.Logic.Tests — the app's own behaviour, run with `dotnet test` on any OS.
    No XAML is loaded here and none is needed: what these pin is what the window would otherwise
    decide in a click handler.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FamilyConnect.App.Logic.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FamilyConnect.App.Logic\FamilyConnect.App.Logic.csproj" />
  </ItemGroup>

  <!--
    The record vectors (issue #79) — the Send slot, the video button and the round video's
    arithmetic, printed by tools/board-oracle — for ComposerButton's tests. The copy CI compares
    with the oracle lives beside the Core tests; it is LINKED here, never copied, so there is no
    fourth copy to drift. It lands at Fixtures/record-vectors.json beside the test assembly, as it
    does for the Core tests.
  -->
  <ItemGroup>
    <None Include="..\FamilyConnect.Core.Tests\Fixtures\record-vectors.json" Link="Fixtures\record-vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    The emoji-as-you-type vectors (issue #101), printed by tools/board-oracle (its emoji-typing command), for
    EmojiTypingTests, LINKED from beside the Core tests, where CI compares them with a fresh print, like the record vectors.
  -->
  <ItemGroup>
    <None Include="..\FamilyConnect.Core.Tests\Fixtures\emoji-typing-vectors.json" Link="Fixtures\emoji-typing-vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    The animation-plan vectors (issue #96), printed by tools/board-oracle (its animation-plan command), for
    AnimationTimingTests, LINKED from beside the Core tests, where CI compares them with a fresh print, like the record vectors.
  -->
  <ItemGroup>
    <None Include="..\FamilyConnect.Core.Tests\Fixtures\animation-plan-vectors.json" Link="Fixtures\animation-plan-vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    The renderer the app ships (issue #97), LINKED for the same reason: RichDrawingTests reads fcRich.version out of the very
    fc-rich.js the MSIX carries, so the cache key's version can never be a second, hand-copied string.
  -->
  <ItemGroup>
    <None Include="..\..\src\FamilyConnect.App\Assets\Rich\fc-rich.js" Link="Fixtures\fc-rich.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
