<Project Sdk="Microsoft.NET.Sdk">
  <!--
    FamilyConnect.Core — everything in the Windows client that is not a window: the wire
    (docs/protocol.md), the local cache, the send outbox, and the board's shared arithmetic.
    Pure .NET with no Windows dependency, so it builds and tests on any OS: the Mac this is
    written on cannot build a WinUI app at all (XamlCompiler.exe is net472), and a port whose
    logic could only be verified on Windows would be a port nobody here could verify.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FamilyConnect.Core</RootNamespace>
    <AssemblyName>FamilyConnect.Core</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The nine languages, inside the assembly. English has no file: its keys ARE its values, which
      is the whole point of keying on the source sentence (win/i18n/generate.py writes the other
      eight from the apps' own Localizable.xcstrings).
    -->
    <EmbeddedResource Include="Text\i18n\*.json" />
  </ItemGroup>
</Project>
