<Window
    x:Class="FamilyConnect.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Structure and x:Name only: the screens are chosen by the session's gate, in code. Once there is a family the
        rail on the left carries the four places — chats, the board, the family and settings — as the Mac's sidebar
        and the web client's tabs do; before that it is hidden, and the door or the sign-in fills the window.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Height="44" Padding="16,0,0,0">
            <TextBlock x:Name="TitleText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="LeftCompact"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            IsPaneVisible="False">
            <ContentControl
                x:Name="Screen"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
        </NavigationView>

        <!--
            A call, over the corner of whatever is open (web views/call.rs): who, where it has got to, and what can be done
            about it. Hidden, never collapsed: the page carrying the media lives in it, and a browser engine taken out of the
            tree is one that stops.
        -->
        <Border
            x:Name="CallCard"
            Grid.Row="1"
            Width="360"
            Margin="0,0,24,24"
            Padding="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            CornerRadius="12"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            Opacity="0"
            IsHitTestVisible="False">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="CallFace" VerticalAlignment="Center" IsTabStop="False" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="CallName" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="CallStatus" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Border x:Name="CallPicture" Height="1" CornerRadius="8" Background="Black">
                    <WebView2 x:Name="CallMediaView" />
                </Border>
                <StackPanel x:Name="CallActions" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
