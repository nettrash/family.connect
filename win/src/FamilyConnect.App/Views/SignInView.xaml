<UserControl
    x:Class="FamilyConnect.App.Views.SignInView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Structure and x:Name only: every word is set from code, through the catalogue. A card in the middle of the window, as
        the Mac's form is: the two ways in, what went wrong, and which server this is.
    -->
    <ScrollViewer>
        <Border
            MaxWidth="440"
            Margin="24,56,24,24"
            Padding="32,28,32,24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <StackPanel Spacing="14">
                <Image Width="56" Height="56" HorizontalAlignment="Left" Source="ms-appx:///Assets/Square150x150Logo.png" />
                <TextBlock x:Name="HeadingText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <SelectorBar x:Name="Modes">
                    <SelectorBarItem x:Name="LogInItem" />
                    <SelectorBarItem x:Name="RegisterItem" />
                </SelectorBar>
                <TextBox x:Name="UsernameBox" IsSpellCheckEnabled="False" />
                <TextBox x:Name="DisplayNameBox" Visibility="Collapsed" />
                <PasswordBox x:Name="PasswordField" />
                <TextBlock x:Name="RulesText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SubmitButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                    <ProgressRing x:Name="Working" Grid.Column="1" IsActive="False" Width="20" Height="20" />
                </Grid>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8,0,0" />
                <StackPanel Spacing="2">
                    <HyperlinkButton x:Name="ChangeServerButton" Padding="0,4,0,4" />
                    <TextBlock x:Name="ServerText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
