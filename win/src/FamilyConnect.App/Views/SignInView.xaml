<UserControl
    x:Class="FamilyConnect.App.Views.SignInView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Structure and x:Name only: every word is set from code, through the catalogue. -->
    <ScrollViewer>
        <StackPanel MaxWidth="420" Margin="24,48,24,24" Spacing="12">
            <TextBlock x:Name="HeadingText" FontSize="28" FontWeight="SemiBold" />
            <SelectorBar x:Name="Modes">
                <SelectorBarItem x:Name="LogInItem" />
                <SelectorBarItem x:Name="RegisterItem" />
            </SelectorBar>
            <TextBox x:Name="UsernameBox" IsSpellCheckEnabled="False" />
            <TextBox x:Name="DisplayNameBox" Visibility="Collapsed" />
            <PasswordBox x:Name="PasswordField" />
            <TextBlock x:Name="RulesText" TextWrapping="Wrap" Opacity="0.7" Visibility="Collapsed" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SubmitButton" />
                <ProgressRing x:Name="Working" IsActive="False" Width="20" Height="20" />
            </StackPanel>
            <HyperlinkButton x:Name="ChangeServerButton" Margin="0,24,0,0" />
            <TextBlock x:Name="ServerText" TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
