<UserControl
    x:Class="FamilyConnect.App.Views.ChatsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Structure and x:Name only: every word is set from code, through the catalogue. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Padding="12,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,8">
                <TextBlock x:Name="ChatsHeading" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="LinkText" VerticalAlignment="Bottom" Opacity="0.7" />
            </StackPanel>
            <ListView x:Name="ChatList" Grid.Row="1" SelectionMode="Single" />
            <TextBlock x:Name="EmptyListText" Grid.Row="1" Margin="4,12,0,0" Opacity="0.7" Visibility="Collapsed" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="4,8,0,0">
                <Button x:Name="BoardButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="BoardText" />
                        <InfoBadge x:Name="BoardBadge" Visibility="Collapsed" />
                    </StackPanel>
                </Button>
                <Button x:Name="FamilyButton" />
                <Button x:Name="SettingsButton" />
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1" Padding="12,0,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ConversationTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TypingText" FontSize="12" Opacity="0.7" />
                </StackPanel>
                <Button x:Name="OpenPollsButton" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="OpenPollsText" />
                        <InfoBadge x:Name="OpenPollsBadge" Visibility="Collapsed" />
                    </StackPanel>
                </Button>
            </Grid>
            <ScrollViewer x:Name="MessageScroller" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MessageStack" Padding="0,0,12,0" Spacing="2" />
            </ScrollViewer>
            <Grid x:Name="BannerPanel" Grid.Row="2" ColumnSpacing="8" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BannerText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                <HyperlinkButton x:Name="BannerCancel" Grid.Column="1" />
            </Grid>
            <Grid x:Name="ComposerPanel" Grid.Row="3" ColumnSpacing="8" RowSpacing="6" Margin="0,8,0,0" Visibility="Collapsed" AllowDrop="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="StagingScroller" Grid.ColumnSpan="3" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel x:Name="StagingStrip" Orientation="Horizontal" Spacing="6" />
                </ScrollViewer>
                <ScrollViewer x:Name="SuggestionScroller" Grid.Row="1" Grid.ColumnSpan="3" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel x:Name="SuggestionStrip" Orientation="Horizontal" Spacing="6" />
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                    <Button x:Name="AttachButton">
                        <SymbolIcon Symbol="Attach" />
                    </Button>
                    <Button x:Name="PollButton" Visibility="Collapsed" />
                </StackPanel>
                <TextBox x:Name="ComposerBox" Grid.Row="2" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" />
                <Button x:Name="SendButton" Grid.Row="2" Grid.Column="2" VerticalAlignment="Bottom" />
            </Grid>
            <TextBlock x:Name="ComposerError" Grid.Row="4" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
