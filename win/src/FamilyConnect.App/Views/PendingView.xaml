<UserControl
    x:Class="FamilyConnect.App.Views.PendingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Structure and x:Name only: every word is set from code, through the catalogue. Waiting for the owner, on one card. -->
    <ScrollViewer>
        <Border
            MaxWidth="440"
            Margin="24,56,24,24"
            Padding="32,28,32,24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <StackPanel Spacing="12">
                <Grid Width="56" Height="56" HorizontalAlignment="Left">
                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <SymbolIcon Symbol="Clock" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Grid>
                <TextBlock x:Name="HeadingText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="FamilyText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,12,0,4" />
                <Button x:Name="LogOutButton" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
