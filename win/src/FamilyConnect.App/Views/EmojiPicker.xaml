<UserControl
    x:Class="FamilyConnect.App.Views.EmojiPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="EmojiCellTemplate">
            <TextBlock DataContextChanged="ShowCellEmoji" FontSize="22" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid Width="344" Height="368" RowSpacing="4" RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
            <TextBox x:Name="SearchInput" TextWrapping="Wrap" MaxHeight="40" IsSpellCheckEnabled="False" />
            <Button x:Name="ClearSearch" Grid.Column="1" Visibility="Collapsed">
                <SymbolIcon Symbol="Clear" />
            </Button>
        </Grid>
        <Grid Grid.Row="1">
            <GridView x:Name="Catalogue" SelectionMode="None" IsItemClickEnabled="True"
                      ItemTemplate="{StaticResource EmojiCellTemplate}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" GroupHeaderPlacement="Top" AreStickyGroupHeadersEnabled="True" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock DataContextChanged="ShowSectionName" FontWeight="SemiBold" Margin="6,8,0,4"
                                           AutomationProperties.HeadingLevel="Level2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </GridView.GroupStyle>
            </GridView>
            <Grid x:Name="SearchPane" RowDefinitions="Auto,*" Visibility="Collapsed">
                <TextBlock x:Name="ResultsHeading" FontWeight="SemiBold" Margin="6,4,0,2"
                           AutomationProperties.HeadingLevel="Level2" />
                <GridView x:Name="Results" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                          ItemTemplate="{StaticResource EmojiCellTemplate}" />
                <TextBlock x:Name="EmptyNotice" Grid.Row="1" TextWrapping="Wrap" Margin="6,8"
                           AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
            </Grid>
        </Grid>
        <StackPanel x:Name="Shortcuts" Grid.Row="2" Orientation="Horizontal" Spacing="2"
                    XYFocusKeyboardNavigation="Enabled" />
    </Grid>
</UserControl>
