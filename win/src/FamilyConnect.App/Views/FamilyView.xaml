<UserControl
    x:Class="FamilyConnect.App.Views.FamilyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A section of rows, as Windows Settings draws one: a card, rows inside it, and a heading above it. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Padding" Value="16,10,16,10" />
            <Setter Property="ColumnSpacing" Value="12" />
            <Setter Property="MinHeight" Value="52" />
        </Style>
        <Style x:Key="Rule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="2,22,0,8" />
        </Style>
        <Style x:Key="Footnote" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Problem" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
    </UserControl.Resources>
    <!-- Structure and x:Name only: every word is set from code, through the catalogue. -->
    <Grid Padding="24,16,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8" MaxWidth="720">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" />
            <!-- The rail is the way back to the chats now. -->
            <Button x:Name="DoneButton" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="720" Padding="0,4,16,32">
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <PersonPicture x:Name="FamilyPicture" Width="56" Height="56" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="FamilyNameText" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="MembersText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="NoticeText" Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="ProblemText" Margin="2,12,0,0" Style="{StaticResource Problem}" Visibility="Collapsed" />

                <StackPanel x:Name="OwnerSections">
                    <TextBlock x:Name="InviteHeading" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="InviteCodeText" VerticalAlignment="Center" FontFamily="Consolas" FontSize="22" CharacterSpacing="60" IsTextSelectionEnabled="True" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="CopyButton" />
                                    <Button x:Name="RotateButton" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="InviteFootnote" Style="{StaticResource Footnote}" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="RequestsSection">
                        <TextBlock x:Name="RequestsHeading" Style="{StaticResource Section}" />
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel Spacing="8">
                                <StackPanel x:Name="RequestsList" Spacing="8" />
                                <TextBlock x:Name="RequestsError" Style="{StaticResource Problem}" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="ReportsHeading" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ReportsEmpty" Style="{StaticResource Footnote}" />
                            <StackPanel x:Name="ReportsList" Spacing="12" />
                            <TextBlock x:Name="ReportsError" Style="{StaticResource Problem}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="PolicyHeading" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel Spacing="8">
                            <RadioButtons x:Name="PolicyChoice" />
                            <TextBlock x:Name="PolicyCaption" Style="{StaticResource Footnote}" />
                            <TextBlock x:Name="PolicyError" Style="{StaticResource Problem}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="LimitSection">
                        <TextBlock x:Name="LimitHeading" Style="{StaticResource Section}" />
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel Spacing="8">
                                <ToggleSwitch x:Name="LimitSwitch" />
                                <NumberBox x:Name="LimitBox" HorizontalAlignment="Left" MinWidth="180" Minimum="1" SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                <TextBlock x:Name="LimitFooter" Style="{StaticResource Footnote}" />
                                <TextBlock x:Name="LimitError" Style="{StaticResource Problem}" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Switches that come and go with their neighbours are spaced, not ruled: a rule would be left under nothing. -->
                    <StackPanel x:Name="AssistantSection">
                        <TextBlock x:Name="LanguageHeading" Style="{StaticResource Section}" />
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel Spacing="8">
                                <ComboBox x:Name="LanguageChoice" MinWidth="220" />
                                <TextBlock x:Name="LanguageFootnote" Style="{StaticResource Footnote}" />
                                <ToggleSwitch x:Name="HistorySwitch" Margin="0,8,0,0" />
                                <TextBlock x:Name="HistoryFootnote" Style="{StaticResource Footnote}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="PicturesHeading" Style="{StaticResource Section}" />
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel Spacing="8">
                                <ToggleSwitch x:Name="VisionSwitch" />
                                <TextBlock x:Name="VisionFootnote" Style="{StaticResource Footnote}" />
                                <ToggleSwitch x:Name="RecentPhotosSwitch" Margin="0,8,0,0" />
                                <TextBlock x:Name="RecentPhotosFootnote" Style="{StaticResource Footnote}" />
                                <ToggleSwitch x:Name="FacesSwitch" Margin="0,8,0,0" />
                                <TextBlock x:Name="FacesFootnote" Style="{StaticResource Footnote}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="GreetingHeading" Style="{StaticResource Section}" />
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel Spacing="8">
                                <ToggleSwitch x:Name="GreetingSwitch" />
                                <TextBlock x:Name="GreetingFootnote" Style="{StaticResource Footnote}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="AssistantError" Margin="2,10,0,0" Style="{StaticResource Problem}" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="MembersHeading" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel x:Name="MembersList" Spacing="10" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
