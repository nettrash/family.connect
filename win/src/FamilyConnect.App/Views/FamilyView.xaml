<UserControl
    x:Class="FamilyConnect.App.Views.FamilyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A card per subject: a glyph and a heading at its top, what it holds under them. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="CardHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="12" />
            <Setter Property="Padding" Value="20,16,20,8" />
        </Style>
        <Style x:Key="CardIcon" TargetType="FontIcon">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardBody" TargetType="StackPanel">
            <Setter Property="Padding" Value="20,4,20,18" />
            <Setter Property="Spacing" Value="8" />
        </Style>
        <!-- A switch beside the words that say what it does, as Windows Settings draws one. -->
        <Style x:Key="SwitchRow" TargetType="Grid">
            <Setter Property="Padding" Value="20,8,20,12" />
            <Setter Property="ColumnSpacing" Value="24" />
        </Style>
        <Style x:Key="Footnote" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Problem" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
    </UserControl.Resources>
    <!-- Structure and x:Name only: every word is set from code, through the catalogue. -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <!--
            From the rail's edge, never centred in an empty window. Wide, an owner's window is two columns — the family's
            rules, and the people in it beside them — and narrow it is one (FamilyView.Arrange moves the members).
        -->
        <Grid x:Name="Body" Padding="36,20,36,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="820" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.ColumnSpan="2" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Heading" Style="{StaticResource TitleLargeTextBlockStyle}" FontSize="32" />
                <!-- The rail is the way back to the chats now. -->
                <Button x:Name="DoneButton" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
            </Grid>

            <!-- The family itself. -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                <Border Style="{StaticResource Card}" Padding="24,20,24,20">
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <PersonPicture x:Name="FamilyPicture" Width="72" Height="72" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="FamilyNameText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="MembersText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="NoticeText" Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="ProblemText" Margin="2,12,0,0" Style="{StaticResource Problem}" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel x:Name="MainColumn" Grid.Row="2">
                <StackPanel x:Name="OwnerSections">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardHeader}">
                                <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE8FA;" />
                                <TextBlock x:Name="InviteHeading" Style="{StaticResource CardTitle}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource CardBody}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border HorizontalAlignment="Left" CornerRadius="6" Padding="16,6,16,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock x:Name="InviteCodeText" FontFamily="Consolas" FontSize="24" CharacterSpacing="120" IsTextSelectionEnabled="True" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:Name="CopyButton" />
                                        <Button x:Name="RotateButton" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="InviteFootnote" Style="{StaticResource Footnote}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="RequestsSection" Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardHeader}">
                                <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE77B;" />
                                <TextBlock x:Name="RequestsHeading" Style="{StaticResource CardTitle}" />
                            </StackPanel>
                            <StackPanel x:Name="RequestsList" Padding="0,0,0,8" />
                            <TextBlock x:Name="RequestsError" Margin="20,0,20,16" Style="{StaticResource Problem}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardHeader}">
                                <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE7BA;" />
                                <TextBlock x:Name="ReportsHeading" Style="{StaticResource CardTitle}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource CardBody}">
                                <TextBlock x:Name="ReportsEmpty" Style="{StaticResource Footnote}" />
                                <StackPanel x:Name="ReportsList" Spacing="12" />
                                <TextBlock x:Name="ReportsError" Style="{StaticResource Problem}" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardHeader}">
                                <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE72E;" />
                                <TextBlock x:Name="PolicyHeading" Style="{StaticResource CardTitle}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource CardBody}">
                                <RadioButtons x:Name="PolicyChoice" />
                                <TextBlock x:Name="PolicyCaption" Style="{StaticResource Footnote}" />
                                <TextBlock x:Name="PolicyError" Style="{StaticResource Problem}" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="LimitSection" Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardHeader}">
                                <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE716;" />
                                <TextBlock x:Name="LimitHeading" Style="{StaticResource CardTitle}" />
                            </StackPanel>
                            <Grid Style="{StaticResource SwitchRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LimitTitle" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch x:Name="LimitSwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Style="{StaticResource CardBody}" Padding="20,0,20,18">
                                <NumberBox x:Name="LimitBox" HorizontalAlignment="Left" MinWidth="180" Minimum="1" SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                                <TextBlock x:Name="LimitFooter" Style="{StaticResource Footnote}" />
                                <TextBlock x:Name="LimitError" Style="{StaticResource Problem}" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Switches that come and go with their neighbours are spaced, not ruled: a rule would be left under nothing. -->
                    <StackPanel x:Name="AssistantSection">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource CardHeader}">
                                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE774;" />
                                    <TextBlock x:Name="LanguageHeading" Style="{StaticResource CardTitle}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource CardBody}" Padding="20,4,20,8">
                                    <ComboBox x:Name="LanguageChoice" MinWidth="240" />
                                    <TextBlock x:Name="LanguageFootnote" Style="{StaticResource Footnote}" />
                                </StackPanel>
                                <Grid Style="{StaticResource SwitchRow}" Padding="20,12,20,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="HistoryTitle" TextWrapping="Wrap" />
                                        <TextBlock x:Name="HistoryFootnote" Style="{StaticResource Footnote}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="HistorySwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Top" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Padding="0,0,0,8">
                                <StackPanel Style="{StaticResource CardHeader}">
                                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE8B9;" />
                                    <TextBlock x:Name="PicturesHeading" Style="{StaticResource CardTitle}" />
                                </StackPanel>
                                <Grid x:Name="VisionRow" Style="{StaticResource SwitchRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="VisionTitle" TextWrapping="Wrap" />
                                        <TextBlock x:Name="VisionFootnote" Style="{StaticResource Footnote}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="VisionSwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Top" />
                                </Grid>
                                <Grid Style="{StaticResource SwitchRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="RecentPhotosTitle" TextWrapping="Wrap" />
                                        <TextBlock x:Name="RecentPhotosFootnote" Style="{StaticResource Footnote}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="RecentPhotosSwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Top" />
                                </Grid>
                                <Grid Style="{StaticResource SwitchRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="FacesTitle" TextWrapping="Wrap" />
                                        <TextBlock x:Name="FacesFootnote" Style="{StaticResource Footnote}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="FacesSwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Top" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Padding="0,0,0,8">
                                <StackPanel Style="{StaticResource CardHeader}">
                                    <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE706;" />
                                    <TextBlock x:Name="GreetingHeading" Style="{StaticResource CardTitle}" />
                                </StackPanel>
                                <Grid Style="{StaticResource SwitchRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="GreetingTitle" TextWrapping="Wrap" />
                                        <TextBlock x:Name="GreetingFootnote" Style="{StaticResource Footnote}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="GreetingSwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Top" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="AssistantError" Margin="2,10,0,0" Style="{StaticResource Problem}" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- The people: under the rules while narrow, beside them while wide. -->
            <StackPanel x:Name="SideColumn" Grid.Row="3" VerticalAlignment="Top">
                <Border Style="{StaticResource Card}">
                    <StackPanel Padding="0,0,0,8">
                        <StackPanel Style="{StaticResource CardHeader}">
                            <FontIcon Style="{StaticResource CardIcon}" Glyph="&#xE716;" />
                            <TextBlock x:Name="MembersHeading" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <StackPanel x:Name="MembersList" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
