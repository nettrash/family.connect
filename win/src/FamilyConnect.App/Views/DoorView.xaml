<UserControl
    x:Class="FamilyConnect.App.Views.DoorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Structure and x:Name only: every word is set from code, through the catalogue. -->
    <ScrollViewer>
        <StackPanel MaxWidth="420" Margin="24,48,24,24" Spacing="12">
            <TextBlock x:Name="JoinHeading" FontSize="28" FontWeight="SemiBold" />
            <TextBox x:Name="CodeBox" PlaceholderText="ABCD2345" IsSpellCheckEnabled="False" />
            <TextBlock x:Name="CodeHelp" TextWrapping="Wrap" Opacity="0.7" />
            <TextBlock x:Name="JoinError" TextWrapping="Wrap" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="JoinButton" />
                <ProgressRing x:Name="JoinWorking" IsActive="False" Width="20" Height="20" />
            </StackPanel>
            <StackPanel x:Name="CreatePanel" Spacing="12" Margin="0,32,0,0">
                <TextBlock x:Name="CreateHeading" FontSize="20" FontWeight="SemiBold" />
                <TextBox x:Name="NameBox" PlaceholderText="The Smiths" MaxLength="64" />
                <TextBlock x:Name="NameHelp" TextWrapping="Wrap" Opacity="0.7" />
                <TextBlock x:Name="CreateError" TextWrapping="Wrap" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="CreateButton" />
                    <ProgressRing x:Name="CreateWorking" IsActive="False" Width="20" Height="20" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="LogOutButton" Margin="0,32,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
