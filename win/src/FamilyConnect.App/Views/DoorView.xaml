<UserControl
    x:Class="FamilyConnect.App.Views.DoorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Structure and x:Name only: every word is set from code, through the catalogue. The two doors into a family, on one card. -->
    <ScrollViewer>
        <Border
            MaxWidth="460"
            Margin="24,56,24,24"
            Padding="32,28,32,24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <StackPanel Spacing="14">
                <Image Width="56" Height="56" HorizontalAlignment="Left" Source="ms-appx:///Assets/Square150x150Logo.png" />
                <!-- The one refusal nothing announces: a request that vanished while this device waited on it. -->
                <InfoBar x:Name="DeclinedBar" Severity="Warning" IsClosable="False" IsOpen="False" />
                <TextBlock x:Name="JoinHeading" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBox x:Name="CodeBox" PlaceholderText="ABCD2345" IsSpellCheckEnabled="False" />
                <TextBlock x:Name="CodeHelp" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="JoinError" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="JoinButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                    <ProgressRing x:Name="JoinWorking" Grid.Column="1" IsActive="False" Width="20" Height="20" />
                </Grid>
                <!-- The rule belongs to the second door: a server that takes no new families hides both. -->
                <StackPanel x:Name="CreatePanel" Spacing="14">
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,10,0,4" />
                    <TextBlock x:Name="CreateHeading" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBox x:Name="NameBox" PlaceholderText="The Smiths" MaxLength="64" />
                    <TextBlock x:Name="NameHelp" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="CreateError" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CreateButton" HorizontalAlignment="Stretch" />
                        <ProgressRing x:Name="CreateWorking" Grid.Column="1" IsActive="False" Width="20" Height="20" />
                    </Grid>
                </StackPanel>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8,0,0" />
                <Button x:Name="LogOutButton" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
