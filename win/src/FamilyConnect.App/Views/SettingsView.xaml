<UserControl
    x:Class="FamilyConnect.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A section of rows, as Windows Settings draws one: a card, rows inside it, and a heading above it. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Padding" Value="16,10,16,10" />
            <Setter Property="ColumnSpacing" Value="12" />
            <Setter Property="MinHeight" Value="52" />
        </Style>
        <Style x:Key="Rule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="2,22,0,8" />
        </Style>
        <Style x:Key="Footnote" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Problem" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
    </UserControl.Resources>
    <!-- Structure and x:Name only: every word is set from code, through the catalogue. -->
    <Grid Padding="24,16,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8" MaxWidth="720">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" />
            <!-- The rail is the way back to the chats now. -->
            <Button x:Name="DoneButton" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="720" Padding="0,4,16,32">
                <Border Style="{StaticResource Card}" Padding="20">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture x:Name="Picture" Width="64" Height="64" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="NameText" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="UsernameText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border x:Name="OwnerCapsule" Grid.Column="2" VerticalAlignment="Center" CornerRadius="10" Padding="10,3,10,3" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock x:Name="OwnerText" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <TextBlock x:Name="ProfileHeading" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PhotoLabel" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="PhotoButton" />
                                <HyperlinkButton x:Name="RemovePhotoButton" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="PhotoError" Margin="16,0,16,10" Style="{StaticResource Problem}" Visibility="Collapsed" />
                        <Border Style="{StaticResource Rule}" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BirthdayLabel" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="BirthdayValue" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <HyperlinkButton x:Name="BirthdayButton" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Rule}" />
                        <Grid Style="{StaticResource Row}">
                            <HyperlinkButton x:Name="PasswordButton" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="FamilySection">
                    <TextBlock x:Name="FamilyHeading" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FamilyNameLabel" VerticalAlignment="Center" />
                                <TextBlock x:Name="FamilyNameValue" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Border Style="{StaticResource Rule}" />
                            <Grid Style="{StaticResource Row}">
                                <HyperlinkButton x:Name="LeaveButton" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </Grid>
                            <TextBlock x:Name="LeaveError" Margin="16,0,16,10" Style="{StaticResource Problem}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="StatisticsHeading" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <Grid Style="{StaticResource Row}">
                        <HyperlinkButton x:Name="StatisticsButton" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock x:Name="NotificationsHeading" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}" Padding="16,10,16,14">
                    <StackPanel Spacing="4">
                        <ToggleSwitch x:Name="NotifySwitch" />
                        <TextBlock x:Name="NotifyFootnote" Style="{StaticResource Footnote}" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="PrivacyHeading" Style="{StaticResource Section}" />
                <!-- The one switch that changes who this app talks to, so it says so plainly. -->
                <Border Style="{StaticResource Card}" Padding="16,10,16,14" Margin="0,0,0,8">
                    <StackPanel Spacing="4">
                        <ToggleSwitch x:Name="LinkPreviewSwitch" />
                        <TextBlock x:Name="LinkPreviewFootnote" Style="{StaticResource Footnote}" />
                    </StackPanel>
                </Border>
                <!-- No rule between the two: the support link is absent on a server that publishes no contact. -->
                <Border Style="{StaticResource Card}" Padding="16,6,16,6">
                    <StackPanel Spacing="2">
                        <HyperlinkButton x:Name="PrivacyLink" Padding="0,8,0,8" />
                        <HyperlinkButton x:Name="SupportLink" Padding="0,8,0,8" />
                    </StackPanel>
                </Border>

                <!-- Which server this device talks to, as the Mac's Settings says it. -->
                <TextBlock x:Name="ServerHeading" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ServerAddressLabel" VerticalAlignment="Center" />
                        <TextBlock x:Name="ServerAddressValue" Grid.Column="1" Margin="16,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,28,0,0">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <HyperlinkButton x:Name="LogOutButton" VerticalAlignment="Center" />
                        </Grid>
                        <Border Style="{StaticResource Rule}" />
                        <Grid Style="{StaticResource Row}">
                            <HyperlinkButton x:Name="DeleteButton" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="VersionText" Margin="0,20,0,0" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
