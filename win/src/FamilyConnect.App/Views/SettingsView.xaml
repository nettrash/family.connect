<UserControl
    x:Class="FamilyConnect.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!--
            Windows 11 Settings' own shape: every setting is a card of its own — a glyph, what it is, and its control at the
            far edge — cards a few pixels apart under a heading, and anything that opens something is the whole card.
        -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Padding" Value="16,12,16,12" />
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="MinHeight" Value="64" />
        </Style>
        <Style x:Key="ActionRow" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12,16,12" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="LinkRow" TargetType="HyperlinkButton">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12,16,12" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="RowIcon" TargetType="FontIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Width" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Chevron" TargetType="FontIcon">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="2,28,0,8" />
        </Style>
        <Style x:Key="Footnote" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Problem" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
    </UserControl.Resources>
    <!-- Structure and x:Name only: every word is set from code, through the catalogue. -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <!-- One column from the rail's edge, as Windows Settings lays one out: never centred in an empty window. -->
        <Grid Padding="36,20,36,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Heading" Style="{StaticResource TitleLargeTextBlockStyle}" FontSize="32" />
                    <!-- The rail is the way back to the chats now. -->
                    <Button x:Name="DoneButton" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                </Grid>

                <!-- Who is signed in. -->
                <Border Style="{StaticResource Card}" CornerRadius="8" Padding="24,20,24,20">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture x:Name="Picture" Width="80" Height="80" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="NameText" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="UsernameText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border x:Name="OwnerCapsule" Grid.Column="2" VerticalAlignment="Center" CornerRadius="12" Padding="12,4,12,5" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock x:Name="OwnerText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <TextBlock x:Name="ProfileHeading" Style="{StaticResource Section}" />
                <StackPanel Spacing="4">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE722;" />
                                <TextBlock x:Name="PhotoLabel" Grid.Column="1" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <HyperlinkButton x:Name="RemovePhotoButton" />
                                    <Button x:Name="PhotoButton" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="PhotoError" Margin="56,0,16,12" Style="{StaticResource Problem}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE787;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="BirthdayLabel" />
                                <TextBlock x:Name="BirthdayValue" Style="{StaticResource Footnote}" />
                            </StackPanel>
                            <Button x:Name="BirthdayButton" Grid.Column="2" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Button x:Name="PasswordButton" Style="{StaticResource ActionRow}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE8D7;" />
                            <TextBlock x:Name="PasswordText" Grid.Column="1" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="2" Style="{StaticResource Chevron}" Glyph="&#xE76C;" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="FamilySection">
                    <TextBlock x:Name="FamilyHeading" Style="{StaticResource Section}" />
                    <StackPanel Spacing="4">
                        <Border Style="{StaticResource Card}">
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE716;" />
                                <TextBlock x:Name="FamilyNameLabel" Grid.Column="1" VerticalAlignment="Center" />
                                <TextBlock x:Name="FamilyNameValue" Grid.Column="2" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Border>
                        <Button x:Name="LeaveButton" Style="{StaticResource ActionRow}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE748;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock x:Name="LeaveText" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <FontIcon Grid.Column="2" Style="{StaticResource Chevron}" Glyph="&#xE76C;" />
                            </Grid>
                        </Button>
                        <TextBlock x:Name="LeaveError" Margin="2,4,0,0" Style="{StaticResource Problem}" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="StatisticsHeading" Style="{StaticResource Section}" />
                <Button x:Name="StatisticsButton" Style="{StaticResource ActionRow}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE9D9;" />
                        <TextBlock x:Name="StatisticsText" Grid.Column="1" VerticalAlignment="Center" />
                        <FontIcon Grid.Column="2" Style="{StaticResource Chevron}" Glyph="&#xE76C;" />
                    </Grid>
                </Button>

                <TextBlock x:Name="NotificationsHeading" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xEA8F;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="NotifyTitle" TextWrapping="Wrap" />
                            <TextBlock x:Name="NotifyFootnote" Style="{StaticResource Footnote}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="NotifySwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <!-- What a closed window does: the notifications above only reach somebody while the app is still running. -->
                <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE770;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="KeepRunningTitle" TextWrapping="Wrap" />
                            <TextBlock x:Name="KeepRunningFootnote" Style="{StaticResource Footnote}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="KeepRunningSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <!-- And whether it is running at all: started at sign-in it goes to the notification area with no -->
                <!-- window, so the first call of the day does not need somebody to have opened the app. The row is -->
                <!-- COLLAPSED where there is no startup task (an unpackaged run), and its switch is disabled where -->
                <!-- Windows will not let this app decide — the person's own Task Manager choice, or policy. -->
                <Border x:Name="StartupCard" Style="{StaticResource Card}" Margin="0,4,0,0" Visibility="Collapsed">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE7E8;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="StartupTitle" TextWrapping="Wrap" />
                            <TextBlock x:Name="StartupFootnote" Style="{StaticResource Footnote}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- The assistant question: who the words go to, whether this member has agreed, and the -->
                <!-- way back out of it (docs/protocol.md, "Consenting to the assistant"). The whole group -->
                <!-- is collapsed where this server named no processor: there is nothing to have agreed to. -->
                <TextBlock x:Name="AssistantHeading" Style="{StaticResource Section}" Visibility="Collapsed" />
                <StackPanel x:Name="AssistantPanel" Spacing="4" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE72E;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="AssistantConsentTitle" TextWrapping="Wrap" />
                                <TextBlock x:Name="AssistantConsentFootnote" Style="{StaticResource Footnote}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button x:Name="AssistantConsentButton" Style="{StaticResource ActionRow}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE734;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="AssistantConsentAction" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <FontIcon Grid.Column="2" Style="{StaticResource Chevron}" Glyph="&#xE8A7;" />
                        </Grid>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="PrivacyHeading" Style="{StaticResource Section}" />
                <StackPanel Spacing="4">
                    <!-- The one switch that changes who this app talks to, so it says so plainly. -->
                    <Border Style="{StaticResource Card}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE71B;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="LinkPreviewTitle" TextWrapping="Wrap" />
                                <TextBlock x:Name="LinkPreviewFootnote" Style="{StaticResource Footnote}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="LinkPreviewSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <!-- The other one: a map on a shared location is drawn from OpenStreetMap's tiles, and says so. -->
                    <Border Style="{StaticResource Card}">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE707;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="MapPreviewTitle" TextWrapping="Wrap" />
                                <TextBlock x:Name="MapPreviewFootnote" Style="{StaticResource Footnote}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="MapPreviewSwitch" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <HyperlinkButton x:Name="PrivacyLink" Style="{StaticResource LinkRow}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE72E;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="PrivacyText" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <FontIcon Grid.Column="2" Style="{StaticResource Chevron}" Glyph="&#xE8A7;" />
                        </Grid>
                    </HyperlinkButton>
                    <HyperlinkButton x:Name="SupportLink" Style="{StaticResource LinkRow}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE897;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="SupportText" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <FontIcon Grid.Column="2" Style="{StaticResource Chevron}" Glyph="&#xE8A7;" />
                        </Grid>
                    </HyperlinkButton>
                </StackPanel>

                <!-- Which server this device talks to, as the Mac's Settings says it. -->
                <TextBlock x:Name="ServerHeading" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE774;" />
                        <TextBlock x:Name="ServerAddressLabel" Grid.Column="1" VerticalAlignment="Center" />
                        <TextBlock x:Name="ServerAddressValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>

                <StackPanel Spacing="4" Margin="0,32,0,0">
                    <Button x:Name="LogOutButton" Style="{StaticResource ActionRow}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE7E8;" />
                            <TextBlock x:Name="LogOutText" Grid.Column="1" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="2" Style="{StaticResource Chevron}" Glyph="&#xE76C;" />
                        </Grid>
                    </Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource ActionRow}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock x:Name="DeleteText" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <FontIcon Grid.Column="2" Style="{StaticResource Chevron}" Glyph="&#xE76C;" />
                        </Grid>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="VersionText" Margin="0,24,0,0" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
