<Project Sdk="Microsoft.NET.Sdk">
  <!--
    FamilyConnect.App.Logic — everything the window DOES, with none of the window. The layer
    exists so that the app's behaviour can be written and tested on the Mac this port is
    developed on: XamlCompiler.exe is net472 and cannot run here, so a decision that lives in a
    view's code-behind is a decision nobody here can verify. The same split md.win uses, and for
    the same reason.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FamilyConnect.App.Logic</RootNamespace>
    <AssemblyName>FamilyConnect.App.Logic</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FamilyConnect.Core\FamilyConnect.Core.csproj" />
  </ItemGroup>
  <!--
    The `:name:` table for emoji as you type (issue #101), a copy of web/text/data/emoji-names.tsv that
    tools/emoji/make_names.py writes and CI compares with the original. Embedded, so it ships inside this
    assembly with nothing for the MSIX to list, and the tests read the very bytes the app does. The
    LogicalName is spelled out: EmojiTyping.NamesResource looks it up by exactly this name.
  -->
  <ItemGroup>
    <EmbeddedResource Include="emoji-names.tsv" LogicalName="FamilyConnect.App.Logic.emoji-names.tsv" />
  </ItemGroup>
</Project>
