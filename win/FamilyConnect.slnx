<Solution>
  <Configurations>
    <Platform Name="x64" />
    <Platform Name="ARM64" />
  </Configurations>
  <Folder Name="/src/">
    <!--
      The PORTABLE solution: everything here builds on any OS, and it is what the Mac and the ubuntu
      CI runner build. The WinUI app is in FamilyConnect.Windows.slnx, because its XAML compiler
      is a .NET Framework executable and would fail this solution everywhere but Windows.
    -->
    <Project Path="src/FamilyConnect.Core/FamilyConnect.Core.csproj" />
    <Project Path="src/FamilyConnect.App.Logic/FamilyConnect.App.Logic.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/FamilyConnect.Core.Tests/FamilyConnect.Core.Tests.csproj" />
    <Project Path="tests/FamilyConnect.App.Logic.Tests/FamilyConnect.App.Logic.Tests.csproj" />
  </Folder>
  <Folder Name="/tools/">
    <Project Path="tools/xamlcheck/xamlcheck.csproj" />
  </Folder>
</Solution>
