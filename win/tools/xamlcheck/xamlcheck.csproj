<Project Sdk="Microsoft.NET.Sdk">
  <!--
    xamlcheck — the off-Windows compile check for FamilyConnect.App (see README.md). Lints the app's
    XAML against the WinUI 3 projection read as metadata (System.Reflection.MetadataLoadContext,
    nothing WinRT is ever executed), writes the x:Name / InitializeComponent stubs the XAML
    compiler would have generated, and builds the code-behind in a shadow project outside
    the repo. Plain net10.0 on purpose: it must run wherever the Core tests run.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XamlCheck</RootNamespace>
    <AssemblyName>xamlcheck</AssemblyName>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.11" />
  </ItemGroup>
</Project>
