#!/bin/sh
# Family Connect: on purge, remove what postinst and AppArmor created for the profile
# (docs/packaging.md §7). What dh_apparmor writes, without debhelper. The user's own files are
# never touched.
set -e
if [ "$1" = "purge" ] && ! [ -e "/etc/apparmor.d/family-connect" ]; then
    rm -f /etc/apparmor.d/disable/family-connect /etc/apparmor.d/force-complain/family-connect \
        /etc/apparmor.d/local/family-connect || true
    rm -f /var/cache/apparmor/*/family-connect || true
    rmdir /etc/apparmor.d/disable 2>/dev/null || true
    rmdir /etc/apparmor.d/local 2>/dev/null || true
    rmdir /etc/apparmor.d 2>/dev/null || true
fi
exit 0
