#!/bin/sh
# Family Connect: load the AppArmor profile that lets WebKit's bubblewrap sandbox create its user
# namespace (docs/packaging.md §7). What dh_apparmor writes, without debhelper.
set -e
if [ "$1" = "configure" ]; then
    APP_PROFILE="/etc/apparmor.d/family-connect"
    if [ -f "$APP_PROFILE" ]; then
        LOCAL_APP_PROFILE="/etc/apparmor.d/local/family-connect"
        test -e "$LOCAL_APP_PROFILE" || {
            mkdir -p "$(dirname "$LOCAL_APP_PROFILE")"
            install --mode 644 /dev/null "$LOCAL_APP_PROFILE"
        }
        if aa-enabled --quiet 2>/dev/null; then
            apparmor_parser -r -T -W "$APP_PROFILE" || true
        fi
    fi
fi
exit 0
