<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Deliberately minimal: everything else is generated
	  (GENERATE_INFOPLIST_FILE = YES + INFOPLIST_KEY_* build settings)
	  and merged with this file. Only what cannot be expressed as an
	  INFOPLIST_KEY lives here: the ATS dictionary and the custom
	  default-server key below.

	  NSAllowsLocalNetworking (and nothing broader): a family typically
	  self-hosts the server on a LAN box reachable only over plain
	  http://192.168.x.x or http://name.local, which ATS would otherwise
	  block. Public servers must still be https — no
	  NSAllowsArbitraryLoads here, ever.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Voice calls (docs/protocol.md, "Voice calls"): `voip` is what lets a
	     PushKit push wake the app to ring, and `audio` is what keeps a call's
	     microphone running with the app behind another. Neither is used for
	     anything else. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>voip</string>
	</array>
	<!-- Calls the SYSTEM starts (CallIntents.swift): a Family row tapped in
	     the Phone app's Recents, "Family voice/video call" on a contact card
	     or in Favorites, and Siri's "call Anna on Family". The user-activity
	     types are what makes the Phone app offer Family at all, and the
	     supported intent is what lets Siri hand the app the request in-app
	     (no Intents extension). -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>INStartCallIntent</string>
		<string>INStartAudioCallIntent</string>
		<string>INStartVideoCallIntent</string>
	</array>
	<key>INIntentsSupported</key>
	<array>
		<string>INStartCallIntent</string>
	</array>
	<!--
	  FCDefaultServerURL: the server this build is pre-pointed at, read
	  by AppSettings.defaultServerURL. Expanded from the user-defined
	  build setting FC_DEFAULT_SERVER_URL — empty in Debug/Release (first
	  run asks for a server), https://fc.nettrash.me in Release-nettrash
	  (the App Store build lands straight on Register/Login). Users can
	  still switch servers via "Change server…" on the auth screen.
	-->
	<key>FCDefaultServerURL</key>
	<string>$(FC_DEFAULT_SERVER_URL)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>me.nettrash.FamilyConnect.share</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>familyconnect</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
