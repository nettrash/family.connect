            "value" : "Zwischen 2 und 10 Antworten. Nach dem Senden lassen sie sich nicht mehr ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre 2 y 10 respuestas. No se pueden cambiar una vez enviada la encuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
