{
  "sourceLanguage" : "en",
  "strings" : {
    "@%@" : {
      "comment" : "A label displaying a user's username.",
      "isCommentAutoGenerated" : true,
      "shouldTranslate" : false
    },
    "%@ %lld" : {
      "comment" : "A button that toggles the emoji. The label is a combination of the emoji and the count.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$lld"
          }
        }
      },
      "shouldTranslate" : false
    },
    "%@ has been signed out everywhere." : {
      "comment" : "A message in a password reset alert.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde überall abgemeldet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha cerrado la sesión de %@ en todas partes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La session de %@ a été fermée partout."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はすべての端末からサインアウトされました。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеансы %@ завершены на всех устройствах."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Све сесије за %@ су затворене."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve sesije za %@ su zatvorene."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在所有设备上退出登录。"
          }
        }
      }
    },
    "%@ will be signed out on every device and will need this password to sign back in. Tell it to them somewhere safe — the server has no way to email it." : {
      "comment" : "A message that explains that the password will be used to sign out a user everywhere.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird auf allen Geräten abgemeldet und braucht dieses Passwort, um sich wieder anzumelden. Gib es auf sicherem Weg weiter – der Server kann keine E-Mails verschicken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerrará la sesión de %@ en todos sus dispositivos y necesitará esta contraseña para volver a entrar. Dísela en persona: el servidor no puede enviarla por correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La session de %@ sera fermée sur tous ses appareils et ce mot de passe lui sera nécessaire pour se reconnecter. Transmets-le de vive voix : le serveur ne peut pas l’envoyer par e-mail."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はすべての端末からサインアウトされ、再びサインインするにはこのパスワードが必要です。安全な方法で直接伝えてください。サーバはメールを送れません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ выйдет из аккаунта на всех устройствах, и для входа понадобится этот пароль. Передай его лично — сервер не умеет отправлять почту."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Све сесије за %@ биће затворене, а за поновну пријаву требаће ова лозинка. Пренеси је на сигуран начин — сервер не може да шаље мејлове."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve sesije za %@ biće zatvorene, a za ponovnu prijavu trebaće ova lozinka. Prenesi je na siguran način — server ne može da šalje mejlove."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将在所有设备上退出登录，需要用这个密码重新登录。请当面告诉对方——服务器无法通过邮件发送。"
          }
        }
      }
    },
