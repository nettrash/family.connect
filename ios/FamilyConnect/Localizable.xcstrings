          "stringUnit" : {
            "state" : "translated",
            "value" : "你的其他设备已退出登录。"
          }
        }
      }
    },
    "Your other devices will be signed out. This one stays signed in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine anderen Geräte werden abgemeldet. Dieses bleibt angemeldet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerrará la sesión en tus otros dispositivos. En este seguirás conectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes autres appareils seront déconnectés. Celui-ci reste connecté."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他の端末はサインアウトされます。この端末はサインインしたままです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
