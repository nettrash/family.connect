    },
    "Your direct chats are deleted — for the other person too. So is your private chat with the assistant." : {
      "comment" : "One of the things deleting an account does.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Direktchats werden gelöscht — auch bei der anderen Person. Dein privater Chat mit dem Assistenten ebenso."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus chats directos se eliminan, también para la otra persona. Y tu chat privado con el asistente igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes conversations directes sont supprimées — pour l’autre personne aussi. Ta conversation privée avec l’assistant également."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個別チャットは削除されます。相手の側からも消えます。アシスタントとの個別チャットも同じです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Личные чаты будут удалены — и у собеседника тоже. Личный чат с ассистентом тоже."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоји лични разговори се бришу — и код друге особе. Исто важи и за лични разговор са асистентом."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoji lični razgovori se brišu — i kod druge osobe. Isto važi i za lični razgovor sa asistentom."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的单独对话会被删除，对方那边也一样。和助手的私人对话同样会被删除。"
          }
        }
      }
    },
