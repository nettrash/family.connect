    "+%lld" : {
      "comment" : "The poll voters a bubble had no room to draw a face for, e.g. \"+3\". A plus sign and a number — nothing to translate.",
      "shouldTranslate" : false
    },
    "A day and a month, with no year — so being wished a happy birthday never means publishing your age." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tag und ein Monat, ohne Jahr – Geburtstagsgrüße verraten so nie dein Alter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un día y un mes, sin año: que te feliciten nunca significará publicar tu edad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un jour et un mois, sans année — recevoir des vœux ne révèle jamais ton âge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月と日だけで、年は入りません。誕生日を祝われても、年齢が知られることはありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "День и месяц, без года — поздравления не выдадут твой возраст."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дан и месец, без године — честитке за рођендан никада не откривају твоје године."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dan i mesec, bez godine — čestitke za rođendan nikada ne otkrivaju tvoje godine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有月和日，没有年份——收到生日祝福不会暴露你的年龄。"
          }
        }
      }
    },
    "A day and a month, with no year. Everyone in the family sees it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tag und ein Monat, ohne Jahr. Die ganze Familie sieht ihn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un día y un mes, sin año. Toda la familia lo ve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un jour et un mois, sans année. Toute la famille le voit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月と日だけで、年は入りません。ファミリー全員が見られます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "День и месяц, без года. Его видит вся семья."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дан и месец, без године. Виде га сви у породици."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dan i mesec, bez godine. Vide ga svi u porodici."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有月和日，没有年份。全家人都能看到。"
          }
        }
      }
    },
    "A message can be at most %lld characters." : {
      "comment" : "Shown when text pasted or typed into the composer would go over the message length limit. The argument is the limit in characters.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Nachricht darf höchstens %lld Zeichen haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mensaje puede tener como máximo %lld caracteres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un message peut contenir au maximum %lld caractères."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージは最大%lld文字までです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщение может быть не длиннее %lld символов."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порука може имати највише %lld знакова."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
