          }
        }
      }
    },
    "Your request to join was declined. You can ask for a new invite code and try again." : {
      "comment" : "A message that appears when a user's invitation to join a family is declined.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Anfrage wurde abgelehnt. Du kannst nach einem neuen Einladungscode fragen und es erneut versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu solicitud fue rechazada. Puedes pedir un código nuevo e intentarlo otra vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta demande a été refusée. Tu peux demander un nouveau code d’invitation et réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参加リクエストは拒否されました。新しい招待コードをもらって、もう一度お試しください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заявку отклонили. Можешь попросить новый код приглашения и попробовать снова."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твој захтев за приступ је одбијен. Можеш да затражиш нови позивни код и покушаш поново."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoj zahtev za pristup je odbijen. Možeš da zatražiš novi pozivni kod i pokušaš ponovo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的加入申请被拒绝了。你可以索取新的邀请码再试一次。"
          }
        }
      }
    },
