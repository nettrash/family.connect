    "This address uses plain http. That's fine for a server on your home network, but anyone on the same network can read the traffic." : {
      "comment" : "Advisory under the server address field while it names a local http address.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Adresse verwendet unverschlüsseltes http. Für einen Server in deinem Heimnetz ist das in Ordnung, aber jeder im selben Netz kann den Verkehr mitlesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta dirección usa http sin cifrar. Está bien para un servidor en tu red doméstica, pero cualquiera en la misma red puede leer el tráfico."
