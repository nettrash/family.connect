    "Reinstall Family Connect to start fresh. Your messages are safe on the family server and will re-download." : {
      "comment" : "A message that instructs the user to reinstall Family Connect to start fresh.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiere Family Connect neu, um frisch zu starten. Deine Nachrichten liegen sicher auf dem Familienserver und werden erneut geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinstala Family Connect para empezar de cero. Tus mensajes están a salvo en el servidor familiar y se volverán a descargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réinstalle Family Connect pour repartir de zéro. Tes messages sont en sécurité sur le serveur familial et seront retéléchargés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family Connect を再インストールすると、やり直せます。メッセージはファミリーサーバに安全に保存されており、再ダウンロードされます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переустанови Family Connect, чтобы начать заново. Сообщения в безопасности на сервере семьи и загрузятся снова."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поново инсталирај Family Connect да почнеш испочетка. Твоје поруке су сигурне на породичном серверу и биће поново преузете."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponovo instaliraj Family Connect da počneš ispočetka. Tvoje poruke su sigurne na porodičnom serveru i biće ponovo preuzete."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新安装 Family Connect 即可从头开始。你的消息安全地保存在家庭服务器上，会重新下载。"
          }
        }
      }
    },
