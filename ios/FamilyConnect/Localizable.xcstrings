    "Your account, password, profile picture and birthday are deleted, and every device you are signed in on is signed out." : {
      "comment" : "One of the things deleting an account does.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto, dein Passwort, dein Profilbild und dein Geburtstag werden gelöscht, und alle Geräte, auf denen du angemeldet bist, werden abgemeldet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan tu cuenta, tu contraseña, tu foto de perfil y tu cumpleaños, y se cierra la sesión en todos los dispositivos donde la tengas abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte, ton mot de passe, ta photo de profil et ton anniversaire sont supprimés, et tous les appareils où tu es connecté sont déconnectés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント、パスワード、プロフィール写真、誕生日が削除され、サインインしているすべての端末がサインアウトされます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твоя учётная запись, пароль, фото профиля и день рождения будут удалены, а на всех твоих устройствах сессия завершится."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твој налог, лозинка, слика профила и рођендан се бришу, а све сесије на свим уређајима се затварају."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoj nalog, lozinka, slika profila i rođendan se brišu, a sve sesije na svim uređajima se zatvaraju."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的账户、密码、头像和生日都会被删除，所有已登录的设备都会退出登录。"
          }
        }
      }
    },
    "Your choice" : {
      "comment" : "Appended to a poll answer's accessibility label when it is the one this reader voted for.",
      "localizations" : {
