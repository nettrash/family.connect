    "Your other devices have been signed out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine anderen Geräte wurden abgemeldet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha cerrado la sesión en tus otros dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
