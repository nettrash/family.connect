        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот адрес использует незашифрованный http. Для сервера в домашней сети это нормально, но любой в той же сети может читать трафик."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ова адреса користи обичан http. За сервер у кућној мрежи то је у реду, али свако на истој мрежи може да чита саобраћај."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova adresa koristi običan http. Za server u kućnoj mreži to je u redu, ali svako na istoj mreži može da čita saobraćaj."
