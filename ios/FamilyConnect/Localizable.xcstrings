          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остали твоји уређаји биће одјављени. Овај остаје пријављен."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
