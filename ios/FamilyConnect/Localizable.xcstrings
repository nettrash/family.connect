    "Any family member can read the code to you; the owner finds it in Settings." : {
      "comment" : "A description of how to find the invite code.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Familienmitglied kann ihn dir vorlesen; der Eigentümer findet ihn in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier familiar puede dictártelo; el propietario lo encuentra en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’importe quel membre peut te le lire ; le propriétaire le trouve dans les Réglages."
          }
        },
        "ja" : {
